#!/bin/bash
# smol-present - Interactive slideshow presenter for smol6
#
# Displays narration text in terminal, sends commands to smol6 on Enter.
# Designed for live recording with OBS - you read the narration, press Enter
# to advance, and smol6 does the camera work.
#
# Usage: smol-present <show.show>
#
# Show format (.show files):
#   --- (slide separator)
#   Narration text for you to read aloud.
#   Multiple lines are fine.
#   > command sent to smol6
#   > another command
#   --- (next slide)

SMOL_PORT="${SMOL_PORT:-8888}"
SMOL_HOST="${SMOL_HOST:-127.0.0.1}"

BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[36m'
YELLOW='\033[33m'
GREEN='\033[32m'
MAGENTA='\033[35m'
RED='\033[31m'
RESET='\033[0m'

usage() {
    cat <<EOF
Usage: smol-present <show.show>
       smol-present --generate <pdbid> [resname] [--play]

Interactive slideshow presenter for smol6.

PLAYBACK MODE:
    smol-present <show.show>
        Read a .show file, print narration, send commands to smol6 on
        Enter. Press Enter to advance slides, q to quit.

GENERATE MODE:
    smol-present --generate <pdbid> [resname]
        Fetch a PDB, analyze its protein-ligand interactions, ask
        OpenAI for narration, and write a .show file under
        shows/generated/<pdbid>.show. Stops after writing so you can
        edit the narration.

    smol-present --generate <pdbid> [resname] --play
        Generate the .show file, then immediately enter playback mode.

OPTIONS for --generate:
    --model <name>     Override OpenAI model (default: o3)
    --no-llm           Skip the LLM call; emit placeholder narration
    --output <path>    Custom output path for the .show file

ENV:
    SMOL_HOST          smol6 HTTP host (default: 127.0.0.1)
    SMOL_PORT          smol6 HTTP port (default: 8888)
    OPENAI_API_KEY     required for --generate (unless --no-llm)
EOF
}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

# --- Argument parsing ---
GENERATE_PDB=""
GENERATE_RESNAME=""
GENERATE_MODEL=""
GENERATE_OUTPUT=""
GENERATE_NO_LLM=0
PLAY_AFTER_GEN=0
SHOW=""

if [ "$1" = "--generate" ]; then
    shift
    if [ $# -eq 0 ]; then
        echo -e "${RED}Error: --generate requires a PDB id${RESET}"
        usage
        exit 1
    fi
    GENERATE_PDB="$1"
    shift
    # Optional positional resname (anything not starting with --)
    if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
        GENERATE_RESNAME="$1"
        shift
    fi
    while [ $# -gt 0 ]; do
        case "$1" in
            --play)     PLAY_AFTER_GEN=1; shift ;;
            --no-llm)   GENERATE_NO_LLM=1; shift ;;
            --model)    GENERATE_MODEL="$2"; shift 2 ;;
            --output|-o) GENERATE_OUTPUT="$2"; shift 2 ;;
            -h|--help)  usage; exit 0 ;;
            *) echo -e "${RED}Unknown --generate option: $1${RESET}"; usage; exit 1 ;;
        esac
    done

    # Locate the python generator (sibling of this script)
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    GEN_PY="$SCRIPT_DIR/scripts/smol-gen-show.py"
    if [ ! -x "$GEN_PY" ] && [ ! -f "$GEN_PY" ]; then
        echo -e "${RED}Error: generator not found at $GEN_PY${RESET}"
        exit 1
    fi

    # Build python command
    GEN_ARGS=("$GENERATE_PDB")
    [ -n "$GENERATE_RESNAME" ] && GEN_ARGS+=("$GENERATE_RESNAME")
    [ -n "$GENERATE_MODEL" ] && GEN_ARGS+=("--model" "$GENERATE_MODEL")
    [ -n "$GENERATE_OUTPUT" ] && GEN_ARGS+=("--output" "$GENERATE_OUTPUT")
    [ "$GENERATE_NO_LLM" = "1" ] && GEN_ARGS+=("--no-llm")

    echo -e "${CYAN}Generating .show for ${GENERATE_PDB}...${RESET}"
    OUT_PATH=$(python3 "$GEN_PY" "${GEN_ARGS[@]}")
    GEN_RC=$?
    if [ $GEN_RC -ne 0 ] || [ -z "$OUT_PATH" ]; then
        echo -e "${RED}Generator failed (exit $GEN_RC).${RESET}"
        exit 1
    fi
    echo -e "${GREEN}Wrote ${OUT_PATH}${RESET}"

    if [ "$PLAY_AFTER_GEN" != "1" ]; then
        echo -e "${DIM}Edit the narration if you like, then run:${RESET}"
        echo -e "    smol-present \"$OUT_PATH\""
        exit 0
    fi

    SHOW="$OUT_PATH"
else
    SHOW="$1"
fi

if [ ! -f "$SHOW" ]; then
    echo "Error: Show file not found: $SHOW"
    exit 1
fi

send_cmd() {
    local cmd="$1"
    local result
    result=$(curl -s -m 5 -X POST "http://${SMOL_HOST}:${SMOL_PORT}/command" -d "$cmd" 2>/dev/null)
    if [ $? -ne 0 ]; then
        echo -e "  ${DIM}(smol6 not responding)${RESET}"
    fi
}

# Parse the show file into slides
# Each slide is separated by ---
# Lines starting with > are commands
# Lines starting with # at the top are metadata (title)
# Everything else is narration

declare -a SLIDE_NARRATION
declare -a SLIDE_COMMANDS
current_narration=""
current_commands=""
slide_count=0
show_title=""

while IFS= read -r line || [ -n "$line" ]; do
    # First line starting with # before any --- is the title
    if [ $slide_count -eq 0 ] && [[ "$line" =~ ^#\  ]] && [ -z "$show_title" ]; then
        show_title="${line#\# }"
        continue
    fi

    # Slide separator
    if [[ "$line" == "---" ]]; then
        if [ -n "$current_narration" ] || [ -n "$current_commands" ]; then
            SLIDE_NARRATION[$slide_count]="$current_narration"
            SLIDE_COMMANDS[$slide_count]="$current_commands"
            ((slide_count++))
        fi
        current_narration=""
        current_commands=""
        continue
    fi

    # Skip empty lines at start of slide
    if [ -z "$current_narration" ] && [ -z "$current_commands" ] && [ -z "$line" ]; then
        continue
    fi

    # Command line
    if [[ "$line" =~ ^'>'[[:space:]]*(.*) ]]; then
        current_commands+="${BASH_REMATCH[1]}"$'\n'
        continue
    fi

    # Skip comment lines
    [[ "$line" =~ ^[[:space:]]*## ]] && continue

    # Narration line
    current_narration+="$line"$'\n'

done < "$SHOW"

# Don't forget the last slide
if [ -n "$current_narration" ] || [ -n "$current_commands" ]; then
    SLIDE_NARRATION[$slide_count]="$current_narration"
    SLIDE_COMMANDS[$slide_count]="$current_commands"
    ((slide_count++))
fi

if [ $slide_count -eq 0 ]; then
    echo "Error: No slides found in $SHOW"
    exit 1
fi

# --- Presentation ---

clear
echo -e "${MAGENTA}${BOLD}╔══════════════════════════════════════════════════════════════╗${RESET}"
echo -e "${MAGENTA}${BOLD}║  smol-present                                               ║${RESET}"
echo -e "${MAGENTA}${BOLD}╚══════════════════════════════════════════════════════════════╝${RESET}"
echo ""
if [ -n "$show_title" ]; then
    echo -e "${BOLD}${CYAN}  $show_title${RESET}"
    echo ""
fi
echo -e "${DIM}  $slide_count slides  •  Press Enter to start  •  q to quit${RESET}"
echo ""
read -r -s -p ""

for ((i=0; i<slide_count; i++)); do
    clear

    # Header
    echo -e "${DIM}─── slide $((i+1))/$slide_count ───${RESET}"
    echo ""

    # Show narration
    narration="${SLIDE_NARRATION[$i]}"
    if [ -n "$narration" ]; then
        # Print narration with nice formatting
        while IFS= read -r nline; do
            if [ -z "$nline" ]; then
                echo ""
            else
                echo -e "  ${BOLD}$nline${RESET}"
            fi
        done <<< "$narration"
    fi

    # Send commands
    commands="${SLIDE_COMMANDS[$i]}"
    if [ -n "$commands" ]; then
        echo ""
        while IFS= read -r cmd; do
            [ -z "$cmd" ] && continue

            # Handle @delay directives
            if [[ "$cmd" =~ ^@([0-9]*\.?[0-9]*)$ ]]; then
                delay="${BASH_REMATCH[1]}"
                [ -z "$delay" ] && delay="0.5"
                sleep "$delay"
                continue
            fi

            echo -e "  ${DIM}> $cmd${RESET}"
            send_cmd "$cmd"
        done <<< "$commands"
    fi

    # Wait for Enter (or q to quit)
    echo ""
    if [ $i -lt $((slide_count - 1)) ]; then
        echo -e "${DIM}  [Enter → next slide]${RESET}"
    else
        echo -e "${DIM}  [Enter → end]${RESET}"
    fi

    while true; do
        read -r -s -n 1 key
        if [ "$key" = "q" ] || [ "$key" = "Q" ]; then
            echo ""
            echo -e "${DIM}Stopped.${RESET}"
            exit 0
        fi
        # Enter key (empty read)
        if [ -z "$key" ]; then
            break
        fi
    done
done

clear
echo -e "${GREEN}${BOLD}  ✓ Show complete${RESET}"
echo ""
